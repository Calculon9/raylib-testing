<?xml version="1.0" encoding="UTF-8"?>
    <!-- Contextual DETAIL STRIP: always-present, read-only description line. Runtime construction -->
    <!-- is in detail_strip_system.c, which composes ONE string per frame: the hover hint of the -->
    <!-- element under the pointer (hint= attribute + optional on_hint callback), or, when nothing -->
    <!-- hintable is hovered, the active tool's context (spawn prefab / paint tile). The single -->
    <!-- <Textbox> carries binding= (a BIND_STRING query source) only, refreshed verbatim by the -->
    <!-- binding core, mirroring info_strip.xml. It fills the strip width; height stays the -->
    <!-- standard control height. The textbox holds 63 visible characters (String64). -->
<Container id="detail_strip" layout="inline" width="fill" height="fill">
    <Textbox id="detail_text" io="readonly" binding="detailstrip.text" width="fill" height="fixed" />
</Container>
