<?xml version="1.0" encoding="UTF-8"?>
    <!-- Info strip: read-only hover + selection report. Runtime construction is in -->
    <!-- info_strip_system.c. The five leaf fields are read-only <Textbox> controls (the -->
    <!-- READONLY_INPUT role) carrying binding= (a value SOURCE) only, so the binding core -->
    <!-- refreshes each with the verbatim BIND_STRING query result via Binding_RefreshText (no -->
    <!-- ON/OFF toggle composition - that path is exclusive to bound <Button> toggles). The row is -->
    <!-- inline and every field is width="fill": the inline flow shares the row equally, so there -->
    <!-- are no per-field pixel widths. Height is the standard 25 px control height. -->
<Container id="info_strip" layout="inline" width="fill" height="fill">
    <!-- Cursor-coordinate fields. Root: pointer in the root world's frame (always shown). -->
    <!-- Child: pointer in a hovered nested world's local frame, or a dash over root/empty space. -->
    <Textbox id="info_strip_rootcoords" io="readonly" binding="infostrip.rootcoords" width="fill" height="fixed" />
    <Textbox id="info_strip_childcoords" io="readonly" binding="infostrip.childcoords" width="hug" height="fixed" />
    <Textbox id="info_strip_hover" io="readonly" binding="infostrip.hover" width="fill" height="fixed" />
    <Textbox id="info_strip_selection" io="readonly" binding="infostrip.selection" width="fill" height="fixed" />
    <!-- Active paint tile type (read-only, "Tile: <n>"), surfaced via the same BIND_STRING query -->
    <!-- shim pattern as the fields above. -->
    <Textbox id="info_strip_tile" io="readonly" binding="infostrip.tile" width="hug" height="fixed" />
</Container>
