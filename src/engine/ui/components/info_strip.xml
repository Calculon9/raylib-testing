<?xml version="1.0" encoding="UTF-8"?>
    <!-- Info strip: read-only hover + selection report. Runtime construction is in -->
    <!-- info_strip_system.c. The two leaf labels use binding= (a value SOURCE) only, -->
    <!-- making them read-only live labels refreshed each frame by the binding core. -->
    <!-- Leaves do NOT auto-size to text, so each label carries an explicit fixed size. -->
<Container id="info_strip" title="" layout="inline" width="fill" height="hug">
    <Button id="info_strip_hover" type="simple" text="-" binding="infostrip.hover" size="12.0,0.5" width="fixed" height="fixed" />
    <Button id="info_strip_selection" type="simple" text="-" binding="infostrip.selection" size="12.0,0.5" width="fixed" height="fixed" />
</Container>
