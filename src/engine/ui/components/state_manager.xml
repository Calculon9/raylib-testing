<?xml version="1.0" encoding="UTF-8"?>
    <!-- Describes the state-manager panel; runtime wiring is in state_manager_system.c.   -->
    <!-- Presented to the user as 'Entity Mgmt' and mounted on the former left-panel slot.  -->
    <!-- Layout is selection-driven (see state_manager_system.c). The panel edits ENTITIES only; -->
    <!-- worlds and cells are edited in the World Manager (world_manager.xml):                   -->
    <!--  * header (always): title + sub-line for the entity selection; amber in multi-select.   -->
    <!--  * tabs PHYS | FLAGS | COMP | SHAPE | TREE (SHAPE / TREE hidden in multi-select).      -->
    <!--  * no entity selected: header reads NO ENTITY SELECTED, tab row and views are hidden.   -->
    <!-- View order matters: the five entity views come first, in tab order.                   -->
    <!--                                                                                 -->
    <!-- Stage 1 of the XML migration: InitStateManagerSystem loads this markup through  -->
    <!-- the generic UI loader (mirroring InitLPanel), then an id-registration pass       -->
    <!-- re-acquires every element by id and wires the C-owned behaviour.                 -->
    <!--                                                                                  -->
    <!--  * Flag buttons, component toggles and DELETE are plain <Button> elements        -->
    <!--    (type="simple" for the flag/component toggles, type="submit" for DELETE).      -->
    <!--    Their click handlers and their "<label>: ON/OFF" query-source display are      -->
    <!--    re-attached in C in the id-registration pass; DELETE carries no action= and    -->
    <!--    is wired to HandleEntityDeleteClick in C (deferred, command-queue delete).      -->
    <!--    The primary entity is the one deleted.                                          -->
    <!--                                                                                   -->
    <!--  * binding= attributes are intentionally ABSENT in Stage 1: field VALUES stay     -->
    <!--    driven by the per-frame C refresh (RefreshPhysView etc.). The declarative       -->
    <!--    binding= names return in Stage 2 once StateManager_ResolveBinding honours them.  -->
    <!--                                                                                    -->
    <!--  * io= expresses read-only (io="readonly") vs editable (io="safe"); every          -->
    <!--    titled <Container> uses width="fill" so the boxed section spans the panel and    -->
    <!--    its rows/toggles fill the section inner width (a section with no width/height    -->
    <!--    collapses or clips).                                                             -->
    <!--                                                                                     -->
    <!--  * Gameplay/Components visibility stays in the application (the C refresh            -->
    <!--    toggles it); markup only declares the containers.                                 -->
<ViewHost id="state_manager" layout="stacked" initial-view="phys_view">
    <!-- Fixed header block (outside every View, so it never scrolls and shows on every tab).   -->
    <!-- The selection decides the text (sm.header.title / sm.header.sub query bindings). The   -->
    <!-- box fill is tinted from C in multi-select; the two textboxes are transparent so the     -->
    <!-- box fill shows through. The title is switched to FONT_LARGE in C at registration.       -->
    <Container id="entity_header" width="fill" height="hug" layout="stack" surface="container" padding="0.12">
        <Textbox id="sm_header_title" io="readonly" binding="sm.header.title" surface="transparent" size="5.9,0.4" width="fill" height="fixed" />
        <Textbox id="sm_header_sub" io="readonly" binding="sm.header.sub" surface="transparent" size="5.9,0.34" width="fill" height="fixed" />
    </Container>

    <!-- Entity tabs. Option order MUST equal the first five View ids below (option index == view  -->
    <!-- index). Each tab is sized explicitly (text run + 3 px each side) so all five fit one row   -->
    <!-- of the 300 px panel (280 px of tabs in 288 px of inner width).                            -->
    <!-- The row is hidden from C when no entity is selected; SHAPE and TREE are hidden in multi.   -->
    <ViewSelector id="state_manager_views" type="enumerate" layout="inline_wrap" gap="0,0" width="fill" height="hug">
        <Option text="PHYS" view="phys_view" size="1.04,0.5" />
        <Option text="FLAGS" view="attri_view" size="1.24,0.5" />
        <Option text="COMP" view="components_view" size="1.04,0.5" />
        <Option text="SHAPE" view="geometry_view" size="1.24,0.5" />
        <Option text="TREE" view="ancestry_view" size="1.04,0.5" />
    </ViewSelector>
    <!-- ================= PHYS view ================= -->
    <View id="phys_view" type="STATE_MANAGER_PHYSICS_VIEW" scroll="y" layout="stack">
        <Container id="physics" title="Physics" width="fill" height="hug" layout="stack">
            <!-- Shown from C in multi-select: values here are the primary's and read-only. -->
            <Textbox id="sm_values_note" io="readonly" surface="transparent" size="5.25,0.5" width="fixed" height="fixed" enabled="false" />
            <TextField id="sm_mass" label="Mass" type="float" io="safe" />
            <TextField id="sm_restitution" label="Restitution" type="float" io="safe" />
            <TextField id="sm_friction" label="Friction" type="float" io="safe" />
            <TextField id="sm_vel" label="Vel" type="vector2" io="safe" />
            <TextField id="sm_accel" label="Accel" type="vector2" io="safe" />
            <TextField id="sm_moment" label="Moment" type="vector2" io="safe" />
            <TextField id="sm_angvel" label="AngVel" type="float" io="safe" />
            <TextField id="sm_angaccel" label="AngAccel" type="float" io="readonly" />
        </Container>

        <Container id="transform" title="Transform" width="fill" height="hug" layout="stack">
            <TextField id="sm_anchor" label="Anchor" type="vector2" io="safe" />
            <TextField id="sm_rotation" label="Rot" type="float" io="safe" />
            <TextField id="sm_basis_u" label="Basis u" type="vector2" io="safe" />
            <TextField id="sm_basis_v" label="Basis v" type="vector2" io="safe" />
        </Container>

        <Button id="sm_delete" type="submit" text="DELETE" surface="danger" size="3.22,0.5" width="fill" height="fixed" />
    </View>
    <!-- ================= ATTRI view ================= -->
    <!-- Flag-button grids: each <Button type="simple"> is wired in C in the id pass    -->
    <!-- (handler + user_data + query-source "<label>: ON/OFF" display).                 -->
    <View id="attri_view" type="STATE_MANAGER_ATTRIBUTES_VIEW" scroll="y" layout="stack">
        <Container id="entity_roles" title="Entity" width="fill" height="hug" layout="stack">
            <Button type="simple" id="sm_role_wall" text="WALL" />
            <Button type="simple" id="sm_role_newtonoid" text="NEWTONOID" />
            <Button type="simple" id="sm_role_projectile" text="PROJECTILE" />
            <Button type="simple" id="sm_role_effect" text="EFFECT" />
            <Button type="simple" id="sm_role_camera" text="CAMERA" />
        </Container>
        <Container id="capabilities" title="Capabilities" width="fill" height="hug" layout="stack">
            <Button type="simple" id="sm_cap_damageable" text="DAMAGEABLE" />
            <Button type="simple" id="sm_cap_velocity" text="VELOCITY" />
            <Button type="simple" id="sm_cap_affect_owner" text="AFFECT OWNER" />
            <Button type="simple" id="sm_cap_sensor" text="SENSOR" />
        </Container>
        <Container id="constraints" title="Constraints" width="fill" height="hug" layout="stack">
            <Button type="simple" id="sm_con_position_locked" text="POSITION LOCKED" />
            <Button type="simple" id="sm_con_no_contact_response" text="NO CONTACT RESPONSE" />
        </Container>
        <Container id="status" title="Status" width="fill" height="hug" layout="stack">
            <Button type="simple" id="sm_status_alive" text="ALIVE" />
            <Button type="simple" id="sm_status_sleeping" text="SLEEPING" />
            <Button type="simple" id="sm_status_clocked" text="CLOCKED" />
        </Container>
        <Container id="collision" title="Collision" width="fill" height="hug" layout="stack">
            <Button type="simple" id="sm_coll_wall" text="WALL" />
            <Button type="simple" id="sm_coll_newtonoid" text="NEWTONOID" />
            <Button type="simple" id="sm_coll_projectile" text="PROJECTILE" />
            <Button type="simple" id="sm_coll_effect" text="EFFECT" />
            <Button type="simple" id="sm_coll_camera" text="CAMERA" />
        </Container>
    </View>

    <!-- ================= COMP view (Phase 1: attach/remove only) ================= -->
    <!-- ATTACHED rows (name + Remove) and ADD buttons are plain simple Buttons wired   -->
    <!-- in C in the id pass; the per-frame refresh shows/hides/relabels these fixed     -->
    <!-- slots to reflect the current selection. No inline value editing in Phase 1.     -->
    <!-- The comp_rowN_name Textboxes carry NO binding= on purpose: they are relabelled  -->
    <!-- imperatively via UpdateString64 in RefreshComponentsView (binding-less, like the   -->
    <!-- other fixed-slot readouts).                                                      -->
    <View id="components_view" type="STATE_MANAGER_COMPONENTS_VIEW" scroll="y" layout="stack">
        <Container id="comp_attached" title="Attached" width="fill" height="hug" layout="stack">
            <Container id="comp_row0" width="hug" height="hug" layout="inline">
                <Textbox id="comp_row0_name" io="readonly" size="3.2,0.5" width="fixed" height="fixed" />
                <Button type="simple" id="comp_row0_remove" text="REMOVE" size="2.0,0.5" width="fixed" height="fixed" />
            </Container>
            <Container id="comp_row1" width="hug" height="hug" layout="inline">
                <Textbox id="comp_row1_name" io="readonly" size="3.2,0.5" width="fixed" height="fixed" />
                <Button type="simple" id="comp_row1_remove" text="REMOVE" size="2.0,0.5" width="fixed" height="fixed" />
            </Container>
            <Container id="comp_row2" width="hug" height="hug" layout="inline">
                <Textbox id="comp_row2_name" io="readonly" size="3.2,0.5" width="fixed" height="fixed" />
                <Button type="simple" id="comp_row2_remove" text="REMOVE" size="2.0,0.5" width="fixed" height="fixed" />
            </Container>
            <Container id="comp_row3" width="hug" height="hug" layout="inline">
                <Textbox id="comp_row3_name" io="readonly" size="3.2,0.5" width="fixed" height="fixed" />
                <Button type="simple" id="comp_row3_remove" text="REMOVE" size="2.0,0.5" width="fixed" height="fixed" />
            </Container>
            <Container id="comp_row4" width="hug" height="hug" layout="inline">
                <Textbox id="comp_row4_name" io="readonly" size="3.2,0.5" width="fixed" height="fixed" />
                <Button type="simple" id="comp_row4_remove" text="REMOVE" size="2.0,0.5" width="fixed" height="fixed" />
            </Container>
        </Container>
        <Container id="comp_add" title="Add Component" width="fill" height="hug" layout="stack">
            <Button type="simple" id="comp_add_portal" text="PORTAL" size="4,0.5" width="fixed" height="fixed" />
            <Button type="simple" id="comp_add_rotor"  text="ROTOR"  size="4,0.5" width="fixed" height="fixed" />
            <Button type="simple" id="comp_add_gear"   text="GEAR"   size="4,0.5" width="fixed" height="fixed" />
            <Button type="simple" id="comp_add_health" text="HEALTH" size="4,0.5" width="fixed" height="fixed" />
        </Container>
        <!-- Component data fields (moved from the old PHYS view). Their visibility is driven from C -->
        <!-- by the attached components; in multi-select they show the primary's values, read-only.   -->
        <Container id="gameplay" title="Health / Damage" width="fill" height="hug" layout="stack">
            <TextField id="sm_health" label="Health" type="float" io="safe" />
            <TextField id="sm_max_health" label="MaxHealth" type="float" io="safe" />
            <TextField id="sm_damage" label="Damage" type="float" io="safe" />
        </Container>
        <Container id="components" title="Component Data" width="fill" height="hug" layout="stack">
            <TextField id="sm_portal_cooldown" label="Portal Cooldown" type="integer" io="safe" />
            <TextField id="sm_portal_target_id" label="Portal Dest." type="integer" io="safe" />
            <TextField id="sm_portal_roles" label="Portal Roles" type="integer" io="readonly" />
            <TextField id="sm_relation_type" label="Relation Type" type="integer" io="readonly" />
        </Container>
    </View>

    <!-- ================= GEOMETRY view (v1: readonly surface vectors) ================= -->
    <!-- Read-only listing of the selected entity's surface vectors. The vertex COUNT is a           -->
    <!-- readonly integer; each vertex is a readonly vector2 row in LOCAL coordinates (as stored,     -->
    <!-- relative to the anchor). A fixed pool of geo_vertexN slots (0..MAX_SHAPE_VERTICES-1) is      -->
    <!-- shown/hidden/relabelled per selection by RefreshGeometryView, exactly like the COMP          -->
    <!-- comp_rowN and ANCESTRY ancestry_lineN fixed slots. No binding= on the rows: they are         -->
    <!-- refreshed imperatively via the TextboxField/RefreshTextboxFields path.                        -->
    <View id="geometry_view" type="STATE_MANAGER_GEOMETRY_VIEW" scroll="y" layout="stack">
        <Container id="geo_summary" title="Surface" width="fill" height="hug" layout="stack">
            <TextField id="geo_vertex_count" label="Vertices" type="integer" io="readonly" />
            <TextField id="sm_bounds_min" label="Bounds.min" type="vector2" io="readonly" />
            <TextField id="sm_geo_center" label="Geo.center" type="vector2" io="readonly" />
        </Container>
        <Container id="geo_vertices" title="Vertices (local)" width="fill" height="fill" layout="stack">
