    <!-- ================= ANCESTRY view ================= -->
    <!-- Read-only display of the primary selection's ancestry chain and relation, migrated from -->
    <!-- the former left panel. All rows are readonly <Textbox> controls carrying binding= (a    -->
    <!-- value SOURCE only); the binding core refreshes each per frame from its BIND_STRING query -->
    <!-- shim. Six pre-declared line slots cover the chain; lines beyond its length render blank. -->
    <View id="ancestry_view" type="STATE_MANAGER_ANCESTRY_VIEW" enabled="false" scroll="y" layout="stack">
        <Container id="ancestry" title="Ancestry" width="fill" height="fill" layout="stack_wrap">
            <Textbox id="ancestry_selected" io="readonly" binding="ancestry.selected" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_line0" io="readonly" binding="ancestry.line0" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_line1" io="readonly" binding="ancestry.line1" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_line2" io="readonly" binding="ancestry.line2" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_line3" io="readonly" binding="ancestry.line3" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_line4" io="readonly" binding="ancestry.line4" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_line5" io="readonly" binding="ancestry.line5" size="5.25,0.5" width="fill" height="fixed" />
            <Textbox id="ancestry_relation" io="readonly" binding="ancestry.relation" size="5.25,0.5" width="fill" height="fixed" />
        </Container>
    </View>
</ViewHost>
