            <TextField id="geo_vertex9"  label="V9"  type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex10" label="V10" type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex11" label="V11" type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex12" label="V12" type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex13" label="V13" type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex14" label="V14" type="vector2" io="readonly" field-layout="stacked" />
