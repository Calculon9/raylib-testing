<?xml version="1.0" encoding="UTF-8"?>
    <!-- Describes the state-manager panel; runtime wiring is in state_manager_system.c.   -->
    <!-- Presented to the user as 'Entity Mgmt' and mounted on the former left-panel slot.  -->
    <!-- Layout is selection-driven (see state_manager_system.c). The panel edits ENTITIES only; -->
    <!-- worlds and cells are edited in the World Manager (world_manager.xml):                   -->
    <!--  * header (always): title + sub-line for the entity selection; amber in multi-select.   -->
    <!--  * tabs PHYS | FLAGS | COMP | SHAPE | TREE (SHAPE / TREE hidden in multi-select).      -->
    <!--  * no entity selected: header reads NO ENTITY SELECTED; the tabs and views keep their    -->
    <!--    normal structure with "-" placeholders, locked fields and no actions (see C).        -->
    <!-- View order matters: the five entity views come first, in tab order.                   -->
    <!--                                                                                 -->
    <!-- InitStateManagerSystem loads this markup through the generic UI loader, then an   -->
    <!-- id-registration pass re-acquires every element by id and wires the C-owned        -->
    <!-- behaviour.                                                                        -->
    <!--                                                                                  -->
    <!--  * Flag buttons, component toggles and DELETE are plain <Button> elements        -->
    <!--    (type="simple" for the flag/component toggles, type="submit" for DELETE).      -->
    <!--    Their click handlers and their "<label>: ON/OFF" query-source display are      -->
    <!--    re-attached in C in the id-registration pass; DELETE carries no action= and    -->
    <!--    is wired to HandleEntityDeleteClick in C (deferred, command-queue delete).      -->
    <!--    The primary entity is the one deleted.                                          -->
    <!--                                                                                   -->
    <!--  * binding= is used on the header and the ancestry rows; the other field VALUES      -->
    <!--    are driven by the per-frame C refresh (RefreshPhysView etc.).                    -->
    <!--                                                                                    -->
    <!--  * io= expresses read-only (io="readonly") vs editable (io="safe"); every          -->
    <!--    titled <Container> uses width="fill" so the boxed section spans the panel and    -->
    <!--    its rows/toggles fill the section inner width (a section with no width/height    -->
    <!--    collapses or clips).                                                             -->
    <!--                                                                                     -->
    <!--  * COMP card visibility (attached / available, expanded bodies) stays in the           -->
    <!--    application (the C refresh toggles it); markup only declares the cards.            -->
<ViewHost id="state_manager" layout="stacked" initial-view="phys_view">
    <!-- Fixed header block (outside every View, so it never scrolls and shows on every tab).   -->
    <!-- The selection decides the text (sm.header.title / sm.header.sub query bindings). The   -->
    <!-- box fill (header_fill, amber in multi-select) is set from C, which also adds the coral  -->
    <!-- bottom rule; the two textboxes are transparent so the box fill shows through. The title -->
    <!-- is switched to FONT_LARGE in C at registration.                                         -->
    <Container id="entity_header" width="fill" height="hug" layout="stack" surface="container" padding="6">
        <Textbox id="sm_header_title" io="readonly" binding="sm.header.title" surface="transparent" size="295,20" width="fill" height="fixed" />
        <Textbox id="sm_header_sub" io="readonly" binding="sm.header.sub" surface="transparent" size="295,17" width="fill" height="fixed" />
    </Container>

    <!-- Entity tabs. Option order MUST equal the first five View ids below (option index == view  -->
    <!-- index). Each tab is width="hug": its text run plus ui_standard_tab_padding on both    -->
    <!-- sides (rule R-1), with no per-tab pixel size; inline_wrap wraps the row if it ever overflows. -->
    <!-- The row is always shown; SHAPE and TREE are hidden in multi-select.                       -->
    <ViewSelector id="state_manager_views" type="enumerate" layout="inline_wrap" gap="0,0" width="fill" height="hug">
        <Option text="PHYS" view="phys_view" width="hug" />
        <Option text="FLAGS" view="attri_view" width="hug" />
        <Option text="COMP" view="components_view" width="hug" />
        <Option text="SHAPE" view="geometry_view" width="hug" />
        <Option text="TREE" view="ancestry_view" width="hug" />
    </ViewSelector>
    <!-- ================= PHYS view ================= -->
    <!-- The PHYS view is ONE continuous sage sheet: the View itself carries the container fill (no   -->
    <!-- border) and the 6 px inset, and the Physics / Transform sections are transparent, borderless -->
    <!-- layout groups (no boxed sections). Every field uses field-layout="stacked": a fixed 118 px   -->
    <!-- label column, the field filling the rest, and a vector2 field drawn as two stacked x / y      -->
    <!-- boxes (the row is two control rows + the stack gap tall). unit= draws a muted suffix inside.  -->
    <View id="phys_view" type="STATE_MANAGER_PHYSICS_VIEW" scroll="y" layout="stack" surface="container" border="none" padding="6">
        <Container id="physics" width="fill" height="hug" layout="stack" surface="card" padding="6">
            <Label text="Physics" style="title" />
            <TextField id="sm_mass" label="Mass" type="float" io="safe" field-layout="stacked" />
            <TextField id="sm_restitution" label="Restitution" type="float" io="safe" field-layout="stacked" />
            <TextField id="sm_friction" label="Friction" type="float" io="safe" field-layout="stacked" />
            <TextField id="sm_vel" label="Velocity" type="vector2" io="safe" field-layout="stacked" />
            <TextField id="sm_accel" label="Accel." type="vector2" io="safe" field-layout="stacked" />
            <TextField id="sm_moment" label="Momentum" type="vector2" io="safe" field-layout="stacked" />
            <TextField id="sm_angvel" label="Ang. vel." type="float" io="safe" field-layout="stacked" />
            <TextField id="sm_angaccel" label="Ang. accel." type="float" io="readonly" field-layout="stacked" />
        </Container>

        <Container id="transform" width="fill" height="hug" layout="stack" surface="card" padding="6">
            <Label text="Transform" style="title" />
            <TextField id="sm_anchor" label="Anchor" type="vector2" io="safe" field-layout="stacked" />
            <TextField id="sm_rotation" label="Rotation" type="float" io="safe" field-layout="stacked" unit="rad" />
            <TextField id="sm_basis_u" label="Basis u" type="vector2" io="safe" field-layout="stacked" />
            <TextField id="sm_basis_v" label="Basis v" type="vector2" io="safe" field-layout="stacked" />
        </Container>

        <Button id="sm_delete" type="submit" text="DELETE" surface="danger" width="fill" height="fixed" />
    </View>
    <!-- ================= ATTRI view ================= -->
    <!-- Chip grid on the same continuous sage sheet as PHYS (View surface, sections transparent).   -->
    <!-- Each section is a title Label over an inline_wrap Container with columns="2": the loader/   -->
    <!-- layout size every chip into two equal columns (5 px column gap, 3 px row gap) and a chip    -->
    <!-- whose text is too wide for half the row spans it. Each <Button type="simple"> is wired in C -->
    <!-- in the id pass (handler + user_data + query-source binding); the on/off state is shown by   -->
    <!-- the toggle roles (amber ACTIVE, teal INACTIVE), not by text.                                     -->
    <View id="attri_view" type="STATE_MANAGER_ATTRIBUTES_VIEW" scroll="y" layout="stack" surface="container" border="none" padding="6">
        <Container id="entity_roles" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Entity" style="title" />
            <Container id="entity_roles_grid" width="fill" height="hug" layout="inline_wrap" columns="2" gap="5,3" surface="transparent" padding="0">
                <Button type="simple" id="sm_role_wall" text="WALL" />
                <Button type="simple" id="sm_role_newtonoid" text="NEWTONOID" />
                <Button type="simple" id="sm_role_projectile" text="PROJECTILE" />
                <Button type="simple" id="sm_role_effect" text="EFFECT" />
                <Button type="simple" id="sm_role_camera" text="CAMERA" />
            </Container>
        </Container>
        <Container id="capabilities" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Capabilities" style="title" />
            <Container id="capabilities_grid" width="fill" height="hug" layout="inline_wrap" columns="2" gap="5,3" surface="transparent" padding="0">
                <Button type="simple" id="sm_cap_damageable" text="DAMAGEABLE" />
                <Button type="simple" id="sm_cap_velocity" text="VELOCITY" />
                <Button type="simple" id="sm_cap_affect_owner" text="AFFECT OWNER" />
                <Button type="simple" id="sm_cap_sensor" text="SENSOR" />
            </Container>
        </Container>
        <Container id="constraints" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Constraints" style="title" />
            <Container id="constraints_grid" width="fill" height="hug" layout="inline_wrap" columns="2" gap="5,3" surface="transparent" padding="0">
                <Button type="simple" id="sm_con_position_locked" text="POSITION LOCKED" />
                <Button type="simple" id="sm_con_no_contact_response" text="NO CONTACT RESPONSE" />
            </Container>
        </Container>
        <Container id="status" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Status" style="title" />
            <Container id="status_grid" width="fill" height="hug" layout="inline_wrap" columns="2" gap="5,3" surface="transparent" padding="0">
                <Button type="simple" id="sm_status_alive" text="ALIVE" />
                <Button type="simple" id="sm_status_sleeping" text="SLEEPING" />
                <Button type="simple" id="sm_status_clocked" text="CLOCKED" />
            </Container>
        </Container>
        <Container id="collision" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Collision" style="title" />
            <Container id="collision_grid" width="fill" height="hug" layout="inline_wrap" columns="2" gap="5,3" surface="transparent" padding="0">
                <Button type="simple" id="sm_coll_wall" text="WALL" />
                <Button type="simple" id="sm_coll_newtonoid" text="NEWTONOID" />
                <Button type="simple" id="sm_coll_projectile" text="PROJECTILE" />
                <Button type="simple" id="sm_coll_effect" text="EFFECT" />
                <Button type="simple" id="sm_coll_camera" text="CAMERA" />
            </Container>
        </Container>
    </View>
    <!-- ================= COMP view: Attached / Available halves ================= -->
    <!-- The COMP view is the same continuous sage sheet as PHYS / FLAGS (View surface, no border,    -->
    <!-- 6 px inset). Attached and Available are transparent, unboxed sections under standard         -->
    <!-- style="title" headings. The two-halves behaviour is kept for usability: two fill-height      -->
    <!-- siblings share the View height equally, and each transparent list scrolls in y on its own    -->
    <!-- (scroll="y"; the 4 px side padding is the scrollbar gutter), so a long Attached list never   -->
    <!-- pushes the Available list off screen. Every attachable type (PORTAL, ROTOR, GEAR, HEALTH)    -->
    <!-- has a card in BOTH lists, in that fixed order; C only enables one of the two:                -->
    <!--  * ATTACHED card comp_sec_<type>: a header row (comp_tgl_<type> toggle Button that fills the -->
    <!--    row + comp_btn_<type> REMOVE/ADD action Button, right-aligned) and, for types with data, a -->
    <!--    comp_body_<type> indented 14 px holding the TextFields and the comp_note_<type> Textbox.   -->
    <!--  * AVAILABLE card comp_avail_<type>: the name Label (fills) and the comp_avail_btn_<type> ADD.-->
    <!-- Colours come from roles only: surface="card" is the CARD role (dark teal + cream        -->
    <!-- text, inherited by every caption and field label inside the card by the loader),    -->
    <!-- surface="danger" is REMOVE (coral + ink) and surface="button" is ADD (amber + ink). Body      -->
    <!-- fields use field-layout="stacked" for the standard 118 px label column, measured from the     -->
    <!-- body's indented left edge. Card titles share one text start: the toggle caption is "> NAME",   -->
    <!-- "v NAME" or "  NAME" (C writes the marker) and the Available name reserves the same 2 chars.  -->
    <!-- The action width is rewritten from C when it flips (REMOVE 78 / ADD 48). comp_note_<type>     -->
    <!-- carries no text here; C writes 'values: primary only' once. comp_attached_empty /             -->
    <!-- comp_avail_empty are the empty-state lines.                                                   -->
    <View id="components_view" type="STATE_MANAGER_COMPONENTS_VIEW" scroll="y" layout="stack" surface="container" border="none" padding="6">
        <Container id="comp_attached" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Attached" style="title" />
            <Container id="comp_attached_list" width="fill" height="hug" layout="stack" gap="0,3" padding="0">
                <Label id="comp_attached_empty" text="none attached" enabled="false" />
            <Container id="comp_sec_portal" width="fill" height="hug" layout="stack" surface="card" padding="6">
                <Container id="comp_hdr_portal" width="fill" height="hug" layout="inline" gap="0,0" padding="0">
                    <Button type="simple" id="comp_tgl_portal" text="> PORTAL" surface="transparent" width="fill" />
                    <Button type="simple" id="comp_btn_portal" text="REMOVE" surface="danger" size="78,25" />
                </Container>
                <Container id="comp_body_portal" width="fill" height="hug" layout="stack" padding="0" offset="14,0" enabled="false">
                    <TextField id="sm_portal_cooldown" label="Cooldown" type="integer" io="safe" field-layout="stacked" />
                    <TextField id="sm_portal_target_id" label="Dest." type="integer" io="safe" field-layout="stacked" />
                    <TextField id="sm_portal_roles" label="Roles" type="integer" io="readonly" field-layout="stacked" />
                    <Textbox id="comp_note_portal" io="readonly" surface="transparent" enabled="false" />
                </Container>
            </Container>
            <!-- ROTOR data fields go here: add a <Container id="comp_body_rotor" ... enabled="false"> -->
            <!-- holding the TextFields plus a comp_note_rotor Textbox (copy comp_body_portal), then   -->
            <!-- set has_fields on the ROTOR row of s_comp_ids in state_manager_system.c.              -->
            <Container id="comp_sec_rotor" width="fill" height="hug" layout="stack" surface="card" padding="6">
                <Container id="comp_hdr_rotor" width="fill" height="hug" layout="inline" gap="0,0" padding="0">
                    <Button type="simple" id="comp_tgl_rotor" text="  ROTOR" surface="transparent" width="fill" />
                    <Button type="simple" id="comp_btn_rotor" text="REMOVE" surface="danger" size="78,25" />
                </Container>
            </Container>
            <!-- GEAR data fields go here: same shape as the ROTOR placeholder above (comp_body_gear, -->
            <!-- comp_note_gear, then has_fields on the GEAR row of s_comp_ids).                       -->
            <Container id="comp_sec_gear" width="fill" height="hug" layout="stack" surface="card" padding="6">
                <Container id="comp_hdr_gear" width="fill" height="hug" layout="inline" gap="0,0" padding="0">
                    <Button type="simple" id="comp_tgl_gear" text="  GEAR" surface="transparent" width="fill" />
                    <Button type="simple" id="comp_btn_gear" text="REMOVE" surface="danger" size="78,25" />
                </Container>
            </Container>
            <Container id="comp_sec_health" width="fill" height="hug" layout="stack" surface="card" padding="6">
                <Container id="comp_hdr_health" width="fill" height="hug" layout="inline" gap="0,0" padding="0">
                    <Button type="simple" id="comp_tgl_health" text="> HEALTH" surface="transparent" width="fill" />
                    <Button type="simple" id="comp_btn_health" text="REMOVE" surface="danger" size="78,25" />
                </Container>
                <Container id="comp_body_health" width="fill" height="hug" layout="stack" padding="0" offset="14,0" enabled="false">
                    <TextField id="sm_health" label="Health" type="float" io="safe" field-layout="stacked" />
                    <TextField id="sm_max_health" label="MaxHealth" type="float" io="safe" field-layout="stacked" />
                    <TextField id="sm_damage" label="Damage" type="float" io="safe" field-layout="stacked" />
                    <Textbox id="comp_note_health" io="readonly" surface="transparent" enabled="false" />
                </Container>
            </Container>
            </Container>
        </Container>
        <Container id="comp_avail" width="fill" height="hug" layout="stack" surface="transparent" padding="0">
            <Label text="Available" style="title" />
            <Container id="comp_avail_list" width="fill" height="hug" layout="stack" gap="0,3" padding="0">
                <Label id="comp_avail_empty" text="all attached" enabled="false" />
            <Container id="comp_avail_portal" width="fill" height="hug" layout="inline" gap="0,0" padding="6" surface="card">
                <Label id="comp_avail_name_portal" text="  PORTAL" padding="0" width="fill" />
                <Button type="simple" id="comp_avail_btn_portal" text="ADD" surface="button" size="48,25" />
            </Container>
            <Container id="comp_avail_rotor" width="fill" height="hug" layout="inline" gap="0,0" padding="6" surface="card">
                <Label id="comp_avail_name_rotor" text="  ROTOR" padding="0" width="fill" />
                <Button type="simple" id="comp_avail_btn_rotor" text="ADD" surface="button" size="48,25" />
            </Container>
            <Container id="comp_avail_gear" width="fill" height="hug" layout="inline" gap="0,0" padding="6" surface="card">
                <Label id="comp_avail_name_gear" text="  GEAR" padding="0" width="fill" />
                <Button type="simple" id="comp_avail_btn_gear" text="ADD" surface="button" size="48,25" />
            </Container>
            <Container id="comp_avail_health" width="fill" height="hug" layout="inline" gap="0,0" padding="6" surface="card">
                <Label id="comp_avail_name_health" text="  HEALTH" padding="0" width="fill" />
                <Button type="simple" id="comp_avail_btn_health" text="ADD" surface="button" size="48,25" />
            </Container>
            </Container>
        </Container>
    </View>
    <!-- ================= GEOMETRY view (v1: readonly surface vectors) ================= -->
    <!-- Read-only listing of the selected entity's surface vectors. The vertex COUNT is a           -->
    <!-- readonly integer; each vertex is a readonly vector2 row in LOCAL coordinates (as stored,     -->
    <!-- relative to the anchor). A fixed pool of geo_vertexN slots (0..MAX_SHAPE_VERTICES-1) is      -->
    <!-- shown/hidden/relabelled per selection by RefreshGeometryView, exactly like the ancestry_lineN -->
    <!-- fixed slots of the ANCESTRY view. No binding= on the rows: they are                -->
    <!-- refreshed imperatively via the TextboxField/RefreshTextboxFields path.                        -->
    <!-- Same continuous sage sheet as PHYS: the View carries the container fill, the sections are  -->
    <!-- transparent hug groups, and every field uses field-layout="stacked" (118 px label column;  -->
    <!-- a vector2 row is two stacked x / y boxes). All fields are read-only, so they pick up the   -->
    <!-- dimmed-cream read-only style from the renderer. The vertex list is hug-height (like PHYS)  -->
    <!-- so the View's own scroll="y" scrolls it; disabled pool rows take no space.                  -->
    <View id="geometry_view" type="STATE_MANAGER_GEOMETRY_VIEW" scroll="y" layout="stack" surface="container" border="none" padding="6">
        <Container id="geo_summary" width="fill" height="hug" layout="stack" surface="card" padding="6">
            <Label text="Surface" style="title" />
            <TextField id="geo_vertex_count" label="Vertices" type="integer" io="readonly" field-layout="stacked" />
            <TextField id="sm_bounds_min" label="Bounds.min" type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="sm_geo_center" label="Geo.center" type="vector2" io="readonly" field-layout="stacked" />
        </Container>
        <Container id="geo_vertices" width="fill" height="hug" layout="stack" surface="card" padding="6">
            <Label text="Vertices (local)" style="title" />
            <TextField id="geo_vertex0"  label="V0"  type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex1"  label="V1"  type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex2"  label="V2"  type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex3"  label="V3"  type="vector2" io="readonly" field-layout="stacked" />
            <TextField id="geo_vertex4"  label="V4"  type="vector2" io="readonly" field-layout="stacked" />
