<?xml version="1.0" encoding="UTF-8"?>
    <!-- Describes the state-manager panel; runtime wiring is in state_manager_system.c. -->
    <!-- Views: PHYS, ATTRI, WORLD, CELL.                                                -->
    <!--                                                                                 -->
    <!-- Stage 1 of the XML migration: InitStateManagerSystem loads this markup through  -->
    <!-- the generic UI loader (mirroring InitLPanel), then an id-registration pass       -->
    <!-- re-acquires every element by id and wires the C-owned behaviour.                 -->
    <!--                                                                                  -->
    <!--  * Flag buttons, component toggles and DELETE are plain <Button> elements        -->
    <!--    (type="simple" for the flag/component toggles, type="submit" for DELETE).      -->
    <!--    Their click handlers and their "<label>: ON/OFF" query-source display are      -->
    <!--    re-attached in C in the id-registration pass; DELETE carries no action= and    -->
    <!--    is wired to HandleBtnSubmitClick in C to preserve the deferred, world-guarded   -->
    <!--    delete behaviour.                                                               -->
    <!--                                                                                   -->
    <!--  * binding= attributes are intentionally ABSENT in Stage 1: field VALUES stay     -->
    <!--    driven by the per-frame C refresh (RefreshPhysView etc.). The declarative       -->
    <!--    binding= names return in Stage 2 once StateManager_ResolveBinding honours them.  -->
    <!--                                                                                    -->
    <!--  * io= expresses read-only (io="readonly") vs editable (io="safe"); every          -->
    <!--    <Container> uses width="hug" height="fill" with layout="stack_wrap" so its width -->
    <!--    hugs its content while its height fills the view, letting fields wrap into        -->
    <!--    columns instead of clipping (a container with no width/height collapses/clips).   -->
    <!--                                                                                     -->
    <!--  * Gameplay/Components visibility stays in the application (the C refresh            -->
    <!--    toggles it); markup only declares the containers.                                 -->
<ViewHost id="state_manager" layout="stacked" initial-view="phys_view">
    <ViewSelector id="state_manager_views" type="enumerate">
        <Option text="PHYS" view="phys_view" />
        <Option text="ATTRI" view="attri_view" />
        <Option text="WORLD" view="world_view" />
        <Option text="CELL" view="cell_view" />
    </ViewSelector>

    <!-- ================= PHYS view ================= -->
    <View id="phys_view" type="STATE_MANAGER_PHYSICS_VIEW" scroll="x" layout="inline">
        <Container id="identity" title="Identity" width="hug" height="fill" layout="stack_wrap">
            <TextField id="sm_id" label="Id:" type="integer" io="readonly" />
            <TextField id="sm_slot" label="Slot:" type="integer" io="readonly" />
            <TextField id="sm_generation" label="Generation:" type="integer" io="readonly" />
            <TextField id="sm_world" label="World" type="integer" io="readonly" />
        </Container>

        <Container id="physics" title="Physics" width="hug" height="fill" layout="stack_wrap">
            <TextField id="sm_mass" label="Mass" type="float" io="safe" />
            <TextField id="sm_restitution" label="Restitution" type="float" io="safe" />
            <TextField id="sm_friction" label="Friction" type="float" io="safe" />
            <TextField id="sm_anchor" label="Anchor" type="vector2" io="safe" />
            <TextField id="sm_vel" label="Vel" type="vector2" io="safe" />
            <TextField id="sm_accel" label="Accel" type="vector2" io="safe" />
            <TextField id="sm_moment" label="Moment" type="vector2" io="safe" />
            <TextField id="sm_angvel" label="AngVel" type="float" io="safe" />
            <TextField id="sm_angaccel" label="AngAccel" type="float" io="readonly" />
        </Container>

        <Container id="geometry" title="Geometry" width="hug" height="fill" layout="stack_wrap">
            <TextField id="sm_bounds_min" label="Bounds.min" type="vector2" io="readonly" />
            <TextField id="sm_geo_center" label="Geo.center" type="vector2" io="readonly" />
            <TextField id="sm_rotation" label="Rot" type="float" io="safe" />
            <TextField id="sm_basis_u" label="Basis u" type="vector2" io="safe" />
            <TextField id="sm_basis_v" label="Basis v" type="vector2" io="safe" />
        </Container>

        <Container id="gameplay" title="Gameplay" width="hug" height="fill" layout="stack_wrap">
            <TextField id="sm_health" label="Health" type="float" io="safe" />
            <TextField id="sm_max_health" label="MaxHealth" type="float" io="safe" />
            <TextField id="sm_damage" label="Damage" type="float" io="safe" />
        </Container>

        <Container id="components" title="Components" width="hug" height="fill" layout="stack_wrap">
            <!-- Component toggles: wired in C (HandleComponentToggleClick) in the id pass. -->
            <Button type="simple" id="sm_comp_portal" text="PORTAL" />
            <Button type="simple" id="sm_comp_rotor" text="ROTOR" />
            <Button type="simple" id="sm_comp_gear" text="GEAR" />
            <Button type="simple" id="sm_comp_health" text="HEALTH" />
            <TextField id="sm_portal_cooldown" label="Portal Cooldown" type="integer" io="safe" />
            <TextField id="sm_portal_target_id" label="Portal Dest." type="integer" io="safe" />
            <TextField id="sm_portal_roles" label="Portal Roles" type="integer" io="readonly" />
            <TextField id="sm_relation_type" label="Relation Type" type="integer" io="readonly" />
        </Container>

        <Button id="sm_delete" type="submit" text="DELETE" size="3.22,0.5" width="fixed" height="fixed" />
    </View>

    <!-- ================= ATTRI view ================= -->
    <!-- Flag-button grids: each <Button type="simple"> is wired in C in the id pass    -->
    <!-- (handler + user_data + query-source "<label>: ON/OFF" display).                 -->
    <View id="attri_view" type="STATE_MANAGER_ATTRIBUTES_VIEW" scroll="x" layout="inline">
        <Container id="entity_roles" title="Entity" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" id="sm_role_wall" text="WALL" />
            <Button type="simple" id="sm_role_newtonoid" text="NEWTONOID" />
            <Button type="simple" id="sm_role_projectile" text="PROJECTILE" />
            <Button type="simple" id="sm_role_effect" text="EFFECT" />
            <Button type="simple" id="sm_role_camera" text="CAMERA" />
        </Container>
        <Container id="capabilities" title="Capabilities" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" size="4,0.5" id="sm_cap_damageable" text="DAMAGEABLE" />
            <Button type="simple" size="4,0.5" id="sm_cap_velocity" text="VELOCITY" />
            <Button type="simple" size="4,0.5" id="sm_cap_affect_owner" text="AFFECT OWNER" />
            <Button type="simple" size="4,0.5" id="sm_cap_sensor" text="SENSOR" />
        </Container>
        <Container id="constraints" title="Constraints" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" size="5,0.5" id="sm_con_position_locked" text="POSITION LOCKED" />
            <Button type="simple" size="5,0.5" id="sm_con_no_contact_response" text="NO CONTACT RESPONSE" />
        </Container>
        <Container id="status" title="Status" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" id="sm_status_alive" text="ALIVE" />
            <Button type="simple" id="sm_status_sleeping" text="SLEEPING" />
            <Button type="simple" id="sm_status_clocked" text="CLOCKED" />
        </Container>
        <Container id="collision" title="Collision" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" id="sm_coll_wall" text="WALL" />
            <Button type="simple" id="sm_coll_newtonoid" text="NEWTONOID" />
            <Button type="simple" id="sm_coll_projectile" text="PROJECTILE" />
            <Button type="simple" id="sm_coll_effect" text="EFFECT" />
            <Button type="simple" id="sm_coll_camera" text="CAMERA" />
        </Container>
    </View>

    <!-- ================= WORLD view ================= -->
    <!-- Starts disabled (enabled when a world is the active selection context). -->
    <View id="world_view" type="STATE_MANAGER_WORLD_VIEW" enabled="false" scroll="x" layout="inline">
        <Container id="world_flags" title="World" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" id="sm_world_active" text="ACTIVE" />
            <Button type="simple" id="sm_world_visible" text="VISIBLE" />
            <Button type="simple" id="sm_world_selectable" text="SELECTABLE" />
            <Button type="simple" id="sm_world_physics" text="PHYSICS" />
            <Button type="simple" id="sm_world_spawns" text="SPAWNS" />
            <Button type="simple" id="sm_world_locked" text="LOCKED" />
            <Button type="simple" id="sm_world_drag" text="DRAG" />
        </Container>
        <Container id="world_physics" title="Physics" width="hug" height="fill" layout="stack_wrap">
            <TextField id="sm_world_restitution" label="Restitution" type="float" io="safe" />
            <TextField id="sm_world_friction" label="Friction" type="float" io="safe" />
        </Container>
    </View>

    <!-- ================= CELL view ================= -->
    <!-- Starts disabled (enabled when a cell is the active selection context). -->
    <View id="cell_view" type="STATE_MANAGER_CELL_STATE_VIEW" enabled="false" scroll="x" layout="inline">
        <Container id="cell_phys" title="Cell" width="hug" height="fill" layout="stack_wrap">
            <TextField id="sm_cell_index" label="Index" type="integer" io="readonly" />
            <TextField id="sm_cell_occu" label="Occu" type="integer" io="readonly" />
            <TextField id="sm_cell_value" label="Value" type="float" io="readonly" />
            <TextField id="sm_cell_fill" label="Fill" type="float" io="readonly" />
        </Container>
        <Container id="cell_flags" title="Flags" width="hug" height="fill" layout="stack_wrap">
            <Button type="simple" id="sm_cell_solid" text="SOLID" />
            <Button type="simple" id="sm_cell_walkable" text="WALKABLE" />
            <Button type="simple" id="sm_cell_hazard" text="HAZARD" />
            <Button type="simple" id="sm_cell_spawn" text="SPAWN" />
        </Container>
    </View>
</ViewHost>
