<?xml version="1.0" encoding="UTF-8"?>
    <!-- Describes the current left panel; runtime construction is in lpanel_system.c. -->
    <!-- Button action attributes use command names resolved by the command system. -->
<ViewHost id="left_panel" layout="stacked" initial-view="state_view">
    <ViewSelector id="left_panel_views" type="enumerate">
        <Option text="STATE" view="state_view" />
    </ViewSelector>

    <View id="state_view" type="LPANEL_STATE_VIEW">
        <Container id="general" width="fill" height="hug" surface="container" padding="6">
            <Label text="General" style="title" />
            <Button type="simple" text="Dashboard" binding="debug.dashboard" action="toggle-debug-dashboard" size="263,25" width="fixed" height="fixed" />
        </Container>

        <Container id="viewport" width="fill" height="hug" surface="container" padding="6">
            <Label text="Viewport" style="title" />
            <Button type="simple" text="Viewport Grid" binding="view.viewport-grid" action="toggle-viewport-grid" size="263,25" width="fixed" height="fixed" />
        </Container>

        <Container id="world" width="fill" height="hug" surface="container" padding="6">
            <Label text="World" style="title" />
            <Button type="simple" text="World Grid" binding="view.world-grid" action="toggle-world-grid" size="263,25" width="fixed" height="fixed" />
            <Button type="simple" text="World Grid Labels" binding="view.world-grid-labels" action="toggle-world-grid-labels" size="263,25" width="fixed" height="fixed" />
            <Button type="simple" text="Universe Grid Labels" binding="view.universe-grid-labels" action="toggle-universe-grid-labels" size="263,25" width="fixed" height="fixed" />
        </Container>

        <Container id="ui" width="fill" height="hug" surface="container" padding="6">
            <Label text="UI" style="title" />
            <Button type="simple" text="UI Borders" binding="view.ui-borders" action="toggle-ui-borders" size="263,25" width="fixed" height="fixed" />
        </Container>

        <Container id="objects" width="fill" height="hug" surface="container" padding="6">
            <Label text="Objects" style="title" />
            <Button type="simple" text="Object Axes" binding="gizmo.object-axes" action="toggle-object-axes" size="263,25" width="fixed" height="fixed" />
            <Button type="simple" text="Object Hull" binding="gizmo.object-hull" action="toggle-object-hull" size="263,25" width="fixed" height="fixed" />
            <Button type="simple" text="Object AABB" binding="gizmo.object-aabb" action="toggle-object-aabb" size="263,25" width="fixed" height="fixed" />
        </Container>
    </View>
</ViewHost>