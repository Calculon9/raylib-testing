<View id="state_view" type="LPANEL_STATE_VIEW" scrollable="false">
    <Section id="general" title="General" size-mode="content_fill">
        <Button type="simple" text="Dashboard" action="toggle-debug-dashboard" size="4.65,0.5" size-mode="fixed" />
    </Section>

    <Section id="viewport" title="Viewport" size-mode="content_fill">
        <Button type="simple" text="Viewport Grid" action="toggle-viewport-grid" size="4.65,0.5" size-mode="fixed" />
    </Section>

    <Section id="world" title="World" size-mode="content_fill">
        <Button type="simple" text="World Grid" action="toggle-world-grid" size="4.65,0.5" size-mode="fixed" />
        <Button type="simple" text="World Grid Labels" action="toggle-world-grid-labels" size="4.65,0.5" size-mode="fixed" />
        <Button type="simple" text="Universe Grid Labels" action="toggle-universe-grid-labels" size="4.65,0.5" size-mode="fixed" />
    </Section>

    <Section id="ui" title="UI" size-mode="content_fill">
        <Button type="simple" text="UI Borders" action="toggle-ui-borders" size="4.65,0.5" size-mode="fixed" />
    </Section>

    <Section id="objects" title="Objects" size-mode="content_fill">
        <Button type="simple" text="Object Axes" action="toggle-object-axes" size="4.65,0.5" size-mode="fixed" />
        <Button type="simple" text="Object Hull" action="toggle-object-hull" size="4.65,0.5" size-mode="fixed" />
        <Button type="simple" text="Object AABB" action="toggle-object-aabb" size="4.65,0.5" size-mode="fixed" />
    </Section>
</View>

