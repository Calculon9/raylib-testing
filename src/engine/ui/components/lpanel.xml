<?xml version="1.0" encoding="UTF-8"?>
    <!-- Describes the current left panel; runtime construction is in lpanel_system.c. -->
    <!-- Button action attributes use command names resolved by the command system. -->
<ViewHost id="left_panel" layout="stacked" initial-view="state_view">
    <ViewSelector id="left_panel_views" type="enumerate">
        <Option text="STATE" view="state_view" />
        <Option text="DRAW" view="draw_view" />
    </ViewSelector>

    <View id="state_view" type="LPANEL_STATE_VIEW">
        <Container id="general" title="General" width="fill" height="hug">
            <Button type="simple" text="Dashboard" binding="debug.dashboard" action="toggle-debug-dashboard" size="5.25,0.5" width="fixed" height="fixed" />
        </Container>

        <Container id="viewport" title="Viewport" width="fill" height="hug">
            <Button type="simple" text="Viewport Grid" binding="view.viewport-grid" action="toggle-viewport-grid" size="5.25,0.5" width="fixed" height="fixed" />
        </Container>

        <Container id="world" title="World" width="fill" height="hug">
            <Button type="simple" text="World Grid" binding="view.world-grid" action="toggle-world-grid" size="5.25,0.5" width="fixed" height="fixed" />
            <Button type="simple" text="World Grid Labels" binding="view.world-grid-labels" action="toggle-world-grid-labels" size="5.25,0.5" width="fixed" height="fixed" />
            <Button type="simple" text="Universe Grid Labels" binding="view.universe-grid-labels" action="toggle-universe-grid-labels" size="5.25,0.5" width="fixed" height="fixed" />
        </Container>

        <Container id="ui" title="UI" width="fill" height="hug">
            <Button type="simple" text="UI Borders" binding="view.ui-borders" action="toggle-ui-borders" size="5.25,0.5" width="fixed" height="fixed" />
        </Container>

        <Container id="objects" title="Objects" width="fill" height="hug">
            <Button type="simple" text="Object Axes" binding="gizmo.object-axes" action="toggle-object-axes" size="5.25,0.5" width="fixed" height="fixed" />
            <Button type="simple" text="Object Hull" binding="gizmo.object-hull" action="toggle-object-hull" size="5.25,0.5" width="fixed" height="fixed" />
            <Button type="simple" text="Object AABB" binding="gizmo.object-aabb" action="toggle-object-aabb" size="5.25,0.5" width="fixed" height="fixed" />
        </Container>
    </View>

    <View id="draw_view" type="LPANEL_DRAW_VIEW">
        <Container id="object_create" title="Object Create" width="fill" height="hug">
            <TextField id="vertices" label="Vertices" type="integer" binding="physics.vertice_count" value="4" />
            <TextField id="width" label="Width" type="float" binding="physics.width" value="1.0" />
            <TextField id="height" label="Height" type="float" binding="physics.height" value="1.0" />
            <TextField id="mass" label="Mass" type="float" binding="physics.mass" value="1.0" />
            <TextField id="restitution" label="Restitution" type="float" binding="physics.restitution" value="0.9" />
            <TextField id="friction" label="Friction" type="float" binding="physics.friction" value="0.5" />
            <TextField id="anchor" label="Anchor" type="vector2" binding="physics.anchor_position" value="0,0" />
            <TextField id="velocity" label="Vel" type="vector2" binding="physics.velocity" value="0,0" />
            <TextField id="acceleration" label="Acc" type="vector2" />
            <TextField id="moment" label="Moment" type="vector2" />
            <Button id="create_entity" type="submit" text="CREATE" action="create-entity" size="4.65,0.5" width="fixed" height="fixed" />
        </Container>
    </View>
</ViewHost>