{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and Debug",
            "type": "cppdbg",
            "request": "launch",
            // Point this to the exact path of your compiled binary
            "program": "${workspaceFolder}/build/raylib-game/raylib-game.exe", 
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/raylib-game",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb", // Use "lldb" if on macOS
            "preLaunchTask": "Build", // Matches the label in tasks.json
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}