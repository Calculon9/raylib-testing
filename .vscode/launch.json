{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and Debug",
            "type": "cppvsdbg",
            "request": "launch",
            // Point this to the exact path of your compiled binary
            "program": "${workspaceFolder}/build/raylib-game/raylib-game.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/raylib-game/",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "Build" // Matches the label in tasks.json
        },
        {
            "name": "Build and Debug (PATH)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/raylib-game/raylib-game.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/raylib-game/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Build (PATH)"
        }
    ]
}