        {
            "type": "shell",
            "label": "CMake-Create-Makefile",
            "command": "cmake",
            "args": ["-DCMAKE_BUILD_TYPE=Debug", "-S", "${workspaceFolder}", "-B","${workspaceFolder}/build" ]          
        },
        {
            "type": "shell",
            "label": "CMake-Execute-Makefile",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build" ],
            "dependsOn": ["CMake-Create-Makefile"],
            "problemMatcher": ["$gcc"]      
        },
        {
            "label": "Raylib Build",
            "dependsOn": ["CMake-Execute-Makefile"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
